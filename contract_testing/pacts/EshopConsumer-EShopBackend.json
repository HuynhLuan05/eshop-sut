        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/login"
      },
      "response": {
        "body": {
          "message": "Login successful",
          "token": "mocked-jwt-token"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.token": {
              "combine": "AND",
              "matchers": [
                {
