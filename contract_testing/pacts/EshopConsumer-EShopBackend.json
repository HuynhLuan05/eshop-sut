{
  "consumer": {
    "name": "EshopConsumer"
  },
  "interactions": [
    {
      "description": "a request to add item to cart with empty body",
      "providerStates": [
        {
          "name": "a valid auth token exists, user cart is empty, and product with ID 1 exists"
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Authorization": "Bearer mock-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/cart"
      },
      "response": {
        "body": {
          "message": "Added to cart"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to add item to cart with invalid token",
